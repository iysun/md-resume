# DeepSeek API（必填，后端启动依赖）
# 也支持使用 OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL 命名
API_KEY=sk-xxx
BASE_URL=https://api.deepseek.com
MODEL=deepseek-chat

# API 服务端口
PDF_PORT=3001

# SQLite 数据库路径（相对 pdf-server 工作目录）
DATABASE_PATH=./data/md-resume.db

# 前端 PDF 模式：client = 浏览器打印；server = Puppeteer 一键下载
VITE_PDF_MODE=client
